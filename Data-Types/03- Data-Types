// 1. String

let name = "Sahithya";
console.log(name);
console.log(typeof name);

// Output: Sahithya
// string

// How it works: A string is text written inside quotes.


// 2. Number

let age = 22;
console.log(age);
console.log(typeof age);

// Output: 22
// number

// How it works:
// A number stores numeric values.


// 3. Boolean

let isStudent = true;
console.log(isStudent);
console.log(typeof isStudent);

// Output: true
// boolean

// How it works: A boolean can only be true or false.


// 4. Undefined

let city;
console.log(city);
console.log(typeof city);

// Output:undefined
// undefined

// How it works: A variable is undefined when no value has been assigned.


// 5. Null

let result = null;
console.log(result);
console.log(typeof result);

// Output: null
// object

// How it works: null means we intentionally have no value.
