// ⚙️ JavaScript Operators


// 1. Arithmetic Operators

let a = 10;
let b = 5;

console.log(a + b); // 15
console.log(a - b); // 5
console.log(a * b); // 50
console.log(a / b); // 2
console.log(a % b); // 0

// Explanation: Arithmetic operators are used to perform calculations.


// 2. Assignment Operators

let x = 10;

x += 5;
console.log(x); // 15

x -= 5;
console.log(x); // 10

// Explanation: Assignment operators are used to assign or update values.


// 3. Comparison Operators

let age = 22;

console.log(age > 18);   // true
console.log(age < 18);   // false
console.log(age === 22); // true

// Explanation: Comparison operators compare values and return true or false.


// 4. == vs ===

console.log(5 == "5");  // true
console.log(5 === "5"); // false

// Explanation: == compares values, while === compares both value and data type.


// 5. Logical Operators

let studentAge = 22;

console.log(studentAge > 18 && studentAge < 30); // true
console.log(studentAge < 18 || studentAge > 20); // true
console.log(!(studentAge > 18));                  // false

// Explanation: Logical operators are used to combine or reverse conditions.
